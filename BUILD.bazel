# SPDX-License-Identifier: ISC
#
# Bazel (Kleaf DDK) build for the QCA6174 SDIO WLAN driver (qcacld-2.0,
# "qcacld-new"), for Android 16 / android16-6.12 GKI kernels in the Amlogic SDK.
#
# Location: this file lives in the qca6174 driver root (next to AIO/, firmware/,
# tools/); all paths are relative to it. There must be NO other BUILD/BUILD.bazel
# file below this directory, or those files fall into a different Bazel package.
#
# This replaces AIO/build + Kbuild for the configuration previously built as:
#   IF_TYPE=SDIO, BOARD_TYPE=re-f30 (CONFIG_CLD_HL_SDIO_CORE=y), MODNAME=wlan
# The source list and defines below are the exact set that configuration
# compiles (flattened from Kbuild). If you change a feature switch in Kbuild,
# re-derive them rather than editing by hand.
#
# NOTE: adjust kernel_build below to your workspace layout; it is the same
# kernel_build the rtl8733bs driver uses. cfg80211 must be built by that
# kernel_build (CONFIG_CFG80211=m on android16-6.12), as for other WLAN
# drivers. This driver uses no Amlogic-specific symbols, so unlike rtl8733bs
# it needs neither //common_drivers:soc_headers nor the amlogic-mmc dep.

load("//build/kernel/kleaf:kernel.bzl", "ddk_headers", "ddk_module")

package(default_visibility = ["//visibility:public"])

ddk_headers(
	name = "qca6174_headers",
	hdrs = glob(["AIO/drivers/qcacld-new/**/*.h"]),
